<Slide style={{
    width: 1280, height: 720,
    padding: 60,
    background: '#FFF7ED',
    fontFamily: 'Microsoft YaHei, Arial',
    position: 'relative',
    flexDirection: 'column',
}}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.2 }}>把三次修改，沉淀成往后所有课件</Text>
        <Box style={{ width: '100%', height: 1, background: '#EA580C', marginTop: 16 }} />
    </Box>
    <Box style={{ width: '100%', height: 106, marginTop: 24, justifyContent: 'center', flexDirection: 'column' }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#C2410C', lineHeight: 1.3 }}>改一次只救一页，沉淀一次救往后所有课件。</Text>
        <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.5, marginTop: 6 }}>原作者最后做对的一件事：把三次修改经验存成检查项。</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 16, height: 310 }}>
        <Box style={{ width: 620, flexDirection: 'column', gap: 10 }}>
            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'center', padding: 10, background: '#FFFFFF', border: '1px solid #E7E5E4', borderRadius: 8 }}>
                <Box style={{ width: 38, height: 38, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Box style={{ width: 520, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>对比度</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.4, marginTop: 2 }}>深色页浅字，≥ 4.5:1，加局部 scrims</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'center', padding: 10, background: '#FFFFFF', border: '1px solid #E7E5E4', borderRadius: 8 }}>
                <Box style={{ width: 38, height: 38, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Box style={{ width: 520, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>背景落地</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.4, marginTop: 2 }}>回读 source，确认写入页面自身背景</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'center', padding: 10, background: '#FFFFFF', border: '1px solid #E7E5E4', borderRadius: 8 }}>
                <Box style={{ width: 38, height: 38, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Box style={{ width: 520, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>边界</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.4, marginTop: 2 }}>box 落在 1280×720 内，四边留 5%</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ width: 516, background: '#FFFFFF', border: '1px solid #FDBA74', borderRadius: 8, padding: 16, flexDirection: 'column' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#78716C' }}>可复制的沉淀提示词</Text>
            <Box style={{ width: '100%', height: 1, background: '#E7E5E4', marginTop: 10, marginBottom: 10 }} />
            <Text style={{ fontSize: 18, color: '#C2410C', lineHeight: 1.5 }}>请把以下三条沉淀为希沃课件生成的强制检查项：<br /><br />1. 对比度 ≥ 4.5:1，深色页用浅字<br />2. 回读背景 source，确认写入页面背景<br />3. box 落在 1280×720 内，四边留 5%<br /><br />生成后逐页截图复核，未通过不交付。</Text>
        </Box>
    </Box>
    <Box style={{ background: '#FDBA74', borderRadius: 8, padding: 16, marginTop: 16, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.5 }}>写死在提示词里，比任何一次「帮我改一下」都值钱</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 670, left: 60, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#78716C' }}>希沃白板 · 特有功能</Text>
        <Text style={{ fontSize: 14, color: '#78716C' }}>09</Text>
    </Box>
</Slide>
