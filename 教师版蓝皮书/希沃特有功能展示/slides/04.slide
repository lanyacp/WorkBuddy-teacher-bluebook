<Slide style={{
    width: 1280, height: 720,
    padding: 60,
    background: '#FFF7ED',
    fontFamily: 'Microsoft YaHei, Arial',
    position: 'relative',
    flexDirection: 'column',
}}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.2 }}>汉字卡：把「峡」字的笔顺搬进课件</Text>
        <Box style={{ width: '100%', height: 1, background: '#EA580C', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 24, height: 424 }}>
        <Box style={{ width: 640, background: '#FFFFFF', borderRadius: 8, border: '1px solid #E7E5E4', padding: 26, flexDirection: 'column', position: 'relative' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#78716C', lineHeight: 1.3 }}>希沃原生元素 · 汉字卡</Text>
            <Box style={{ flexDirection: 'row', gap: 24, marginTop: 20 }}>
                <Box style={{ width: 230, height: 230, background: '#FFF7ED', border: '2px solid #E7E5E4', borderRadius: 8, position: 'relative', justifyContent: 'center', alignItems: 'center' }}>
                    <Box style={{ position: 'absolute', left: 114, top: 0, width: 1, height: 230, background: '#FDBA74' }} />
                    <Box style={{ position: 'absolute', top: 114, left: 0, width: 230, height: 1, background: '#FDBA74' }} />
                    <Text style={{ fontSize: 108, fontWeight: 'bold', color: '#C2410C', textAlign: 'center' }}>峡</Text>
                </Box>
                <Box style={{ width: 320, flexDirection: 'column', gap: 12 }}>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, color: '#78716C', width: 76 }}>部首</Text>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917' }}>山</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, color: '#78716C', width: 76 }}>笔画</Text>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917' }}>9 画</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, color: '#78716C', width: 76 }}>结构</Text>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917' }}>左右结构</Text>
                    </Box>
                    <Box style={{ width: '100%', height: 1, background: '#E7E5E4', marginTop: 4, marginBottom: 4 }} />
                    <Text style={{ fontSize: 18, color: '#78716C' }}>笔顺演示　1 → 9</Text>
                    <Box style={{ flexDirection: 'row', gap: 8, marginTop: 4 }}>
                        <Box style={{ width: 30, height: 30, borderRadius: 6, background: '#EA580C' }} />
                        <Box style={{ width: 30, height: 30, borderRadius: 6, background: '#FDBA74' }} />
                        <Box style={{ width: 30, height: 30, borderRadius: 6, background: '#FDBA74' }} />
                        <Box style={{ width: 30, height: 30, borderRadius: 6, background: '#FDBA74' }} />
                        <Box style={{ width: 30, height: 30, borderRadius: 6, background: '#FDBA74' }} />
                    </Box>
                    <Box style={{ width: 150, height: 40, borderRadius: 8, background: '#0EA5E9', justifyContent: 'center', alignItems: 'center', marginTop: 8 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>播放笔顺</Text>
                    </Box>
                </Box>
            </Box>
            <Text style={{ fontSize: 18, color: '#78716C', marginTop: 18, lineHeight: 1.5 }}>田字格、笔顺播放、部首信息，都是课件里能点的元素，不是一张图。</Text>
        </Box>
        <Box style={{ width: 496, flexDirection: 'column', gap: 20 }}>
            <Box style={{ flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1C1917' }}>适合什么知识点</Text>
                <Text style={{ fontSize: 18, color: '#1C1917', lineHeight: 1.5 }}>生字笔顺、部首归类、形近字辨析。八年级讲《三峡》，「峡」「嶂」「溯」都能做成卡。</Text>
            </Box>
            <Box style={{ width: '100%', height: 1, background: '#E7E5E4' }} />
            <Box style={{ flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1C1917' }}>提示词照抄</Text>
                <Box style={{ background: '#FFFFFF', border: '1px solid #FDBA74', borderRadius: 8, padding: 16 }}>
                    <Text style={{ fontSize: 18, color: '#C2410C', lineHeight: 1.5 }}>这一页加一个汉字卡，讲「峡」字，要能看笔顺</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1C1917' }}>一个边界</Text>
                <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.5 }}>常用 3500 字范围内才有笔顺数据，生僻字可能出不来。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ background: '#FDBA74', borderRadius: 8, padding: 16, marginTop: 20, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.5 }}>点名「汉字卡」三个字，AI 才会去调希沃的原生组件</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 670, left: 60, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#78716C' }}>希沃白板 · 特有功能</Text>
        <Text style={{ fontSize: 14, color: '#78716C' }}>04</Text>
    </Box>
</Slide>
