<Slide style={{
    width: 1280, height: 720,
    padding: 60,
    background: '#FFF7ED',
    fontFamily: 'Microsoft YaHei, Arial',
    position: 'relative',
    flexDirection: 'column',
}}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.2 }}>生成后必查三件事</Text>
        <Box style={{ width: '100%', height: 1, background: '#EA580C', marginTop: 16 }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 24, height: 424 }}>
        <Box style={{ width: 330, background: '#C2410C', borderRadius: 8, padding: 28, flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 104, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.1 }}>3</Text>
            <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF', marginTop: 8 }}>件必查</Text>
            <Box style={{ width: 120, height: 3, background: '#FDBA74', borderRadius: 2, marginTop: 24, marginBottom: 24 }} />
            <Text style={{ fontSize: 18, color: '#FFEDD5', lineHeight: 1.5 }}>不是 AI 审美不稳定，是三处具体的落地环节没对齐。</Text>
        </Box>
        <Box style={{ width: 806, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', gap: 16, padding: 16, borderBottom: '1px solid #E7E5E4' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>P1</Text>
                </Box>
                <Box style={{ width: 700, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>黑字压在深色背景上，看不清</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.5, marginTop: 6 }}>原因：配图按「好不好看」生成，字色按模板默认值排，两者没人对齐。</Text>
                    <Text style={{ fontSize: 18, color: '#C2410C', lineHeight: 1.5, marginTop: 4 }}>解法：深色页用白/浅字，对比度 ≥ 4.5:1，标题区加局部 scrims。</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 16, padding: 16, borderBottom: '1px solid #E7E5E4' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>P4</Text>
                </Box>
                <Box style={{ width: 700, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>某一页突然没有背景图</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.5, marginTop: 6 }}>原因：背景要写进页面自身背景再回读，中途失败就丢，属资源落地失败。</Text>
                    <Text style={{ fontSize: 18, color: '#C2410C', lineHeight: 1.5, marginTop: 4 }}>解法：逐页回读 source，缺失立即补写，别只说「再美化一下」。</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 16, padding: 16 }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#EA580C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>P6</Text>
                </Box>
                <Box style={{ width: 700, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.3 }}>表格太大，越出画面</Text>
                    <Text style={{ fontSize: 18, color: '#78716C', lineHeight: 1.5, marginTop: 6 }}>原因：表格按内容自动撑开，没被 1280×720 画布边界约束。</Text>
                    <Text style={{ fontSize: 18, color: '#C2410C', lineHeight: 1.5, marginTop: 4 }}>解法：列数 ≤ 4、宽 ≤ 80%、四边留 ≥ 5% 安全边距，越界就拆页。</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ background: '#FDBA74', borderRadius: 8, padding: 16, marginTop: 20, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1C1917', lineHeight: 1.5 }}>别把 AI 说「完成」当完成——回读 + 逐页截图复核，这一步不能省</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 670, left: 60, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#78716C' }}>希沃白板 · 特有功能</Text>
        <Text style={{ fontSize: 14, color: '#78716C' }}>08</Text>
    </Box>
</Slide>
